{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firstdraftstudios",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/demo/*"]
  },
  "r2_buckets": [
    { "binding": "DEMOS", "bucket_name": "firstdraft-demos" }
  ],
  "routes": [
    { "pattern": "firstdraftstudios.ca", "custom_domain": true },
    { "pattern": "www.firstdraftstudios.ca", "custom_domain": true }
  ]
}
