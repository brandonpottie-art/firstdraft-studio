{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firstdraftstudios",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "firstdraftstudios.ca", "custom_domain": true },
    { "pattern": "www.firstdraftstudios.ca", "custom_domain": true }
  ]
}
